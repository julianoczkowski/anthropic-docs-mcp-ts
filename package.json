{
  "name": "@julianoczkowski/anthropic-docs-mcp-ts",
  "version": "0.1.1",
  "description": "MCP server for searching and fetching Anthropic documentation",
  "main": "dist/server.js",
  "type": "module",
  "bin": {
    "anthropic-docs-mcp": "dist/server.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts --transport stdio",
    "dev:http": "tsx src/server.ts --transport http --port 8974",
    "build": "tsc",
    "start": "node dist/server.js --transport stdio",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests specified\""
  },
  "files": [
    "dist/",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anthropic",
    "documentation",
    "search",
    "fetch",
    "typescript"
  ],
  "author": "Julian Oczkowski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julianoczkowski/anthropic-docs-mcp-ts.git"
  },
  "homepage": "https://github.com/julianoczkowski/anthropic-docs-mcp-ts#readme",
  "bugs": {
    "url": "https://github.com/julianoczkowski/anthropic-docs-mcp-ts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "cheerio": "^1.1.2",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
